# Copy this file to .env and fill in real values.
# .env itself is gitignored and must never be committed.

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pgcc?retryWrites=true&w=majority
JWT_SECRET=generate-a-long-random-string-here
GMAIL_EMAIL=your-school-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
# Needed on Render's free tier (it blocks Gmail SMTP). Get a key at brevo.com -> SMTP & API -> API Keys.
# BREVO_SENDER_EMAIL must be a sender you've verified in Brevo (e.g. your school Gmail).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your-school-email@gmail.com
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=your-encryption-key
SITE_URL=http://localhost:5500
CLIENT_ORIGIN=*
PORT=5000
